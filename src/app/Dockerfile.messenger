FROM ubuntu:22.04 AS builder

# Установка зависимостей сборки
# Обновляем список пакетов и устанавливаем необходимые инструменты
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libboost-dev \
    libboost-system-dev \
    libboost-thread-dev \
    libboost-coroutine-dev \
    libsqlite3-dev \
    libargon2-dev \
    libprometheus-cpp-dev \
    # libprotobuf-dev protobuf-compiler (Если prometheus-cpp требует)
    && rm -rf /var/lib/apt/lists/*

# Копируем исходный код проекта
WORKDIR /app
COPY . .

# Создаем директорию для сборки и собираем проект
# (Предполагается, что у вас есть CMakeLists.txt или вы адаптируете Makefile)
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
RUN cmake --build build --config Release -j $(nproc)

# Этап 2: Запуск
FROM ubuntu:22.04

# Установка зависимостей времени выполнения
# Нужны только те библиотеки, с которыми слинковано приложение
RUN apt-get update && apt-get install -y \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    # libboost-coroutine1.74.0 (если используется) \
    libsqlite3-0 \
    libargon2-1 \
    # libprometheus-cpp-core / libprometheus-cpp-pull (или какие там runtime либы) \
    # libprotobuf (если нужно) \
    && rm -rf /var/lib/apt/lists/*

# Создаем пользователя и группу для запуска приложения (лучше не от root)
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Создаем директорию для данных и устанавливаем права
RUN mkdir /data && chown appuser:appuser /data
VOLUME /data # Делаем /data томом для хранения БД

WORKDIR /app

# Копируем собранный исполняемый файл сервера из этапа сборки
COPY --from=builder /app/build/tcp_server .
# Возможно, нужно скопировать и другие файлы, если они нужны серверу

# Устанавливаем владельца исполняемого файла
RUN chown appuser:appuser tcp_server

# Переключаемся на непривилегированного пользователя
USER appuser

# Порты, которые открывает сервер, 8080 app 9090 metrics
EXPOSE 8080 
EXPOSE 9090 

# Команда для запуска сервера
# Убедитесь, что БД будет создана в /data/messenger.db (это путь по умолчанию в коде)
CMD ["./tcp_server"]